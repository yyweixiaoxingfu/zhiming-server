# 统一换行符，避免跨平台协作时产生大量无意义 diff
* text=auto eol=lf

# 二进制资源不做换行转换，也不参与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.zip  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.svg  text eol=lf

# 第三方依赖不参与语言统计与代码搜索
/vendor/       linguist-vendored
/public/static/libs/ linguist-vendored
/public/static/admin/ linguist-vendored
/thinkphp/     linguist-documentation
