; -------------------------------------------------------------
; 本地环境配置模板
; 使用方式：复制本文件为 .env，然后按实际环境修改各项值
; .env 已被 .gitignore 忽略，不会被提交到仓库
; -------------------------------------------------------------

; 应用调试模式，生产环境务必改为 false
APP_DEBUG = false

[DATABASE]
HOSTNAME = 127.0.0.1
DATABASE = zhiming
USERNAME = root
PASSWORD = your_password
HOSTPORT = 3306
PREFIX = w_

[JWT]
; 请自行生成一个足够随机的字符串，不要使用示例值
; 生成方式示例： php -r "echo bin2hex(random_bytes(32));"
SECRET = please_change_me_to_a_random_string
JWT_TTL = 40000
JWT_REFRESH_TTL = 120

; 是否单模块模式
SINGLE = false
